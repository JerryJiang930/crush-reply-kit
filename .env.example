# Prefer the browser model settings after npm start.
# Optional legacy Jev settings below; browser-saved settings take precedence.
# Run npm run setup to configure Jev from the terminal.
# Choices: typesafe | vercel | openrouter | opencode. No URL or model setting needed.
# opencode uses the limited-time free Jev model only; it never falls back to paid models.
JEV_PROVIDER=typesafe
JEV_API_KEY=
PORT=3178
HOST=127.0.0.1

# Optional Liquid AI native System One configuration (fixed d1-ultra model).
# Browser-saved settings take precedence. Never reuse another provider's key.
# CRUSH_PROVIDER=liquid
# LIQUID_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# replysmith 的 IN / THINK / OUT 三步配置。全部可选：一项都不配时，OUT 会退化成
# 「策略 + 理由」的结构化建议，不需要任何模型。
# ─────────────────────────────────────────────────────────────────────

# ── IN：聊天记录从哪来 ──────────────────────────────────────────────
# manual（默认，读 JSON 文件，零依赖）| wechat-decrypt（需你自己跑解密工具）
# SOURCE=manual
# SESSIONS_FILE=examples/sample-sessions.json

# 只有 SOURCE=wechat-decrypt 时才用得上。留空会直接拒绝启动（伦理红线）。
# 只填你已获得同意的会话名，逗号分隔。
# ALLOWED_PEERS=
# WECHAT_DECRYPT_URL=http://127.0.0.1:8000
# 只处理这个时间点之后有新消息的会话（epoch 毫秒），留空=全部
# SINCE_MS=

# ── THINK：判断引擎（决定「下一步该怎么做」）────────────────────────
# 指向一个 System One 兼容的本地判断服务。默认是 Laya。
# LOCAL_ENDPOINT=http://127.0.0.1:8421
# LOCAL_MODEL=convaiinnovations/laya-multilingual
# LOCAL_PROVIDER=laya
# LOCAL_API_KEY=local

# ── OUT：聊天模型（把策略写成一句能直接发的话）──────────────────────
# 任何 OpenAI 兼容接口都能用。preset 提供默认 baseUrl/model，其余逐字段可覆盖。
#
#   DRAFT_PRESET=ollama      → http://127.0.0.1:11434/v1        qwen3:8b    （本机，无需 Key）
#   DRAFT_PRESET=dashscope   → https://dashscope.aliyuncs.com/compatible-mode/v1  qwen3-8b
#   DRAFT_PRESET=deepseek    → https://api.deepseek.com/v1      deepseek-chat
#   DRAFT_PRESET=siliconflow → https://api.siliconflow.cn/v1    Qwen/Qwen3-8B
#
# 换供应商只改 preset（或 endpoint/model），代码不用动。
# DRAFT_PRESET=ollama
# DRAFT_ENDPOINT=
# DRAFT_MODEL=
# DRAFT_API_KEY=
# DRAFT_TEMPERATURE=0.7
# DRAFT_MAX_TOKENS=200
# DRAFT_TIMEOUT_MS=30000

# 也可以写进 .runtime/chat.json（已被 git 忽略）：{"preset":"ollama","model":"qwen3:8b"}
# 环境变量优先级更高，逐字段覆盖文件。

# ── 交付方式 ────────────────────────────────────────────────────────
# print（默认，只打印）| clipboard（复制到剪贴板，你按 Ctrl+V 粘）
# DELIVER_MODE=print

# ── 关系类型 ────────────────────────────────────────────────────────
# crush（默认）| new | couple
# RELATION=crush

