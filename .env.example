# 全部可选。一项都不配也能跑：IN 读示例文件，THINK 打本机 8421，
# OUT 只给结构化建议（策略 + 理由），不写具体句子。
# 复制成 .env 再改；命令行上直接给环境变量会覆盖这里的值。

# ── IN：聊天记录从哪来 ─────────────────────────────────────────────
# manual（读 JSON）| wechat（读 wechat-decrypt 解密出来的库）
# SOURCE=manual
# SESSIONS_FILE=examples/sample-sessions.json

# SOURCE=wechat 时下面两项必填。ALLOWED_PEERS 为空会直接拒绝启动。
# 只写你已获得同意的会话名，逗号分隔。
# WECHAT_DB_DIR=D:/path/to/wechat-decrypt/decrypted
# ALLOWED_PEERS=
# 只处理这个时间点之后有新消息的会话（epoch 毫秒），留空=全部
# SINCE_MS=0

# crush（默认）| new | couple
# RELATION=crush

# ── THINK：判断模型 ───────────────────────────────────────────────
# 任何说 System One 协议的服务。默认按 Laya。
# LOCAL_ENDPOINT=http://127.0.0.1:8421
# LOCAL_PORT=8421
# LOCAL_MODEL=convaiinnovations/laya-multilingual
# 协议方言：systemone | laya | anyjev
# LOCAL_DIALECT=systemone
# LOCAL_API_KEY=local

# ── OUT：聊天模型（把策略写成一句能发的话）──────────────────────────
# 任何 OpenAI 兼容接口。preset 只提供 baseUrl/model 的默认值，逐字段可覆盖。
#
#   DRAFT_PRESET=ollama      → http://127.0.0.1:11434/v1   qwen3:8b    （本机，无需 Key）
#   DRAFT_PRESET=dashscope   → https://dashscope.aliyuncs.com/compatible-mode/v1  qwen3-8b
#   DRAFT_PRESET=deepseek    → https://api.deepseek.com/v1  deepseek-chat
#   DRAFT_PRESET=siliconflow → https://api.siliconflow.cn/v1  Qwen/Qwen3-8B
#
# 换供应商只改 preset。
# DRAFT_PRESET=ollama
# DRAFT_ENDPOINT=
# DRAFT_MODEL=
# DRAFT_API_KEY=
# DRAFT_TEMPERATURE=0.7
# DRAFT_MAX_TOKENS=700
# DRAFT_TIMEOUT_MS=60000
# openai | ollama。本地跑思考模型必须用 ollama：它的兼容路由会忽略 think:false，
# 草稿会把预算花光然后返回空。
# DRAFT_WIRE=

# 也可以写进 .runtime/chat.json（已被 git 忽略）：{"preset":"ollama","model":"qwen3:8b"}
# 环境变量优先级更高，逐字段覆盖文件。
# CHAT_CONFIG_PATH=.runtime/chat.json

# ── 交付 ──────────────────────────────────────────────────────────
# print（默认，只打印）| clipboard（复制到剪贴板，你按 Ctrl+V 粘）
# DELIVER_MODE=print

# ── 启动器（npm run up）专用 ───────────────────────────────────────
# 装 Laya 的虚拟环境
# LAYA_PYTHON=../.venv-laya/Scripts/python.exe
# 本地权重快照目录。设了就完全不联网；不设则去 HF 缓存里自动找。
# LAYA_SNAPSHOT=
# OLLAMA_BIN=~/.local/ollama/bin/ollama.exe
# CHAT_PORT=11434
