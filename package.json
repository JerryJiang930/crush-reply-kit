{
  "name": "replysmith",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx scripts/start.ts",
    "up": "tsx scripts/up.ts",
    "inspect": "tsx scripts/inspect-wechat-db.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "description": "本地读聊天记录，判断关系，给几个回复方向",
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.13",
    "@typesafe-ai/sdk": "^0.6.0",
    "dotenv": "^16.4.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "prettier": "^3.9.8",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  }
}
